stop("Could not find a pathway-name column — check colnames(df) manually.")
}
get_filtered_pathways <- function(df, disease_labels) {
col_idx <- grep("Pathways$", colnames(df))
if (length(col_idx) == 0) {
stop("Could not find a pathway-name column — check colnames(df) manually.")
}
pathway_col <- df[[col_idx[1]]]
pathway_col <- trimws(pathway_col)
pathway_col <- pathway_col[pathway_col != ""]          # drop blank rows
pathway_col <- unique(pathway_col)                     # just in case
pathway_col[!pathway_col %in% disease_labels]          # exclude disease labels
}
