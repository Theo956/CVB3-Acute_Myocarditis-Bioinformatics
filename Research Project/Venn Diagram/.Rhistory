dataset1 <- get_filtered_pathways(raw1, disease_labels)
dataset2 <- get_filtered_pathways(raw2, disease_labels)
dataset3 <- get_filtered_pathways(raw3, disease_labels)
cat("Dataset 1 kept pathways:\n"); print(dataset1)
cat("\nDataset 2 kept pathways:\n"); print(dataset2)
cat("\nDataset 3 kept pathways:\n"); print(dataset3)
# Venn diagram -----------------------------------------------------------------
venn.plot <- venn.diagram(
x = list(
"Dataset 1" = dataset1,
"Dataset 2" = dataset2,
"Dataset 3" = dataset3
),
filename = NULL,
fill = c("#4C72B0", "#DD8452", "#55A868"),
alpha = 0.45,
cex = 1.2,
cat.cex = 1.1,
cat.pos = c(-30, 30, 180),
main = "Overlap of significant KEGG pathways across 3 datasets"
)
View(venn.plot)
# Save as PNG ----
png("pathway_venn_diagram_R.png", width = 2000, height = 1800, res = 200)
grid.draw(venn.plot)
dev.off()
